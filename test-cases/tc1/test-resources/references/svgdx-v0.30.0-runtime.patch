+#[test]
+fn test_text_content_character_references() {
+    let input = r#"
+<text xy="1 5">A &lt; B &amp; C &gt; D</text>
+"#;
+    let expected = r#"
+<text x="1" y="5" class="d-text">A &lt; B &amp; C &gt; D</text>
+"#;
+
+    assert_eq!(
+        transform_str_default(input).unwrap().trim(),
+        expected.trim()
+    );
+
+    for (input, expected) in [
+        (
+            r#"<text xy="1 5">A<![CDATA[B]]> &lt; C</text>"#,
+            r#"<text x="1" y="5" class="d-text">AB &lt; C</text>"#,
+        ),
+        (
+            r#"<text xy="1 5">A &lt; <![CDATA[B]]>C</text>"#,
+            r#"<text x="1" y="5" class="d-text">A &lt; BC</text>"#,
+        ),
+    ] {
+        assert_eq!(transform_str_default(input).unwrap().trim(), expected);
+    }
+}
